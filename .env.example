# SceneSense — copy to .env and fill the two keys (both free tiers work)

# Groq (https://console.groq.com/keys) — Bengali speech-to-text + text LLM fallback
GROQ_API_KEY=
ASR_MODEL=whisper-large-v3
ASR_LANGUAGE=bn
GROQ_LLM_MODEL=openai/gpt-oss-120b

# Google AI Studio (https://aistudio.google.com/apikey) — keyframe + transcript scene understanding
GEMINI_API_KEY=
# Comma-separated, tried in order (models get retired / rate-limited)
GEMINI_MODEL=gemini-3.8-flash,gemini-3.5-flash,gemini-3.1-flash-lite

# Base URL written into the VMAP so external players can fetch creatives
PUBLIC_BASE_URL=http://localhost:8000
